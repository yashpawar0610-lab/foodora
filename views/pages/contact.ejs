<div class="page-static">
  <div class="static-hero">
    <div class="container">
      <span class="pill-badge">Get in Touch</span>
      <h1>We're Here to Help You 24/7</h1>
      <p>Have questions about your order, feedback on a meal, or interested in partnering with us?</p>
    </div>
  </div>

  <div class="container static-content">
    <div class="contact-grid">
      <div class="contact-info-card">
        <h3>Reach Out Directly</h3>
        <p>Our customer happiness team operates around the clock to support your culinary adventures.</p>

        <div class="contact-meta-item">
          <i class="ri-mail-send-line"></i>
          <div>
            <strong>Support Email</strong>
            <p>support@foodora.com</p>
          </div>
        </div>

        <div class="contact-meta-item">
          <i class="ri-phone-line"></i>
          <div>
            <strong>Toll Free Helpline</strong>
            <p>+91 (020) 8000-FOOD (24x7)</p>
          </div>
        </div>

        <div class="contact-meta-item">
          <i class="ri-map-pin-line"></i>
          <div>
            <strong>Headquarters</strong>
            <p>FOODORA Tech Park, Sector 4, Koregaon Park, Pune, MH 411001</p>
          </div>
        </div>
      </div>

      <div class="contact-form-card">
        <h3>Send us a Message</h3>
        <form class="styled-form" onsubmit="event.preventDefault(); alert('Thank you! Our support team will get back to you within 30 minutes.'); this.reset();">
          <div class="form-group">
            <label>Your Name</label>
            <input type="text" placeholder="John Doe" required>
          </div>
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" placeholder="john@example.com" required>
          </div>
          <div class="form-group">
            <label>Subject</label>
            <select>
              <option>Order Issue / Delayed Delivery</option>
              <option>Restaurant Partnership Inquiry</option>
              <option>Food Safety & Quality Concern</option>
              <option>General Feedback / Suggestion</option>
            </select>
          </div>
          <div class="form-group">
            <label>Message</label>
            <textarea rows="4" placeholder="How can we assist you today?" required></textarea>
          </div>
          <button type="submit" class="btn-primary-full"><i class="ri-send-plane-fill"></i> Send Message</button>
        </form>
      </div>
    </div>
  </div>
</div>
