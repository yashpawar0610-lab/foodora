<div class="page-static">
  <div class="static-hero">
    <div class="container">
      <span class="pill-badge">Partner With Us</span>
      <h1>Register Your Restaurant on FOODORA</h1>
      <p>Reach hungry customers across your city and grow your food business exponentially</p>
    </div>
  </div>

  <div class="container static-content" style="max-width:700px;">
    <div class="contact-form-card" style="box-shadow:var(--shadow-lg);">
      <h3 style="margin-bottom:1.5rem;font-size:1.4rem;"><i class="ri-store-2-line" style="color:var(--primary)"></i> Restaurant Information</h3>
      
      <form action="/owner/setup" method="POST" class="styled-form">
        <div class="form-group">
          <label>Restaurant Name</label>
          <input type="text" name="name" placeholder="e.g. Spice Symphony Kitchen" required>
        </div>

        <div class="form-group">
          <label>Description / Story</label>
          <textarea name="description" rows="3" placeholder="Tell customers what makes your kitchen special..." required></textarea>
        </div>

        <div class="form-row-3">
          <div class="form-group">
            <label>City</label>
            <input type="text" name="city" value="Pune" required>
          </div>
          <div class="form-group">
            <label>Area / Locality</label>
            <input type="text" name="area" placeholder="Koregaon Park" required>
          </div>
          <div class="form-group">
            <label>Pincode</label>
            <input type="text" name="pincode" placeholder="411001" required>
          </div>
        </div>

        <div class="form-group">
          <label>Address Details</label>
          <input type="text" name="address" placeholder="Shop 12, Ground Floor, Central Mall..." required>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label>Primary Cuisines (comma-separated)</label>
            <input type="text" name="cuisine" placeholder="North Indian, Biryani, Mughlai" required>
          </div>
          <div class="form-group">
            <label>Approx Price for Two (₹)</label>
            <input type="number" name="priceForTwo" value="450" required>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label>Delivery Time (minutes)</label>
            <input type="number" name="deliveryTime" value="30" required>
          </div>
          <div class="form-group">
            <label>Cover Image URL</label>
            <input type="url" name="coverImage" value="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=800&q=80">
          </div>
        </div>

        <button type="submit" class="btn-primary-full"><i class="ri-rocket-line"></i> Launch My Restaurant</button>
      </form>
    </div>
  </div>
</div>
