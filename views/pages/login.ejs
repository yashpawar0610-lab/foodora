<div class="auth-page">
  <div class="auth-visual">
    <div class="auth-visual-content">
      <div class="auth-logo-large">🍕 FOODORA</div>
      <h2>Good Food.<br>Great Moments.</h2>
      <p>Discover and order from the best restaurants in your city.</p>
      <div class="auth-food-collage">
        <img src="https://images.unsplash.com/photo-1563379091339-03246963d96e?w=200&q=80" alt="">
        <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=200&q=80" alt="">
        <img src="https://images.unsplash.com/photo-1574071318508-1cdbab80d002?w=200&q=80" alt="">
      </div>
    </div>
  </div>
  <div class="auth-form-side">
    <div class="auth-card">
      <h2 class="auth-title">Welcome Back 👋</h2>
      <p class="auth-sub">Login to your FOODORA account</p>

      <% if (msg) { %>
      <div class="alert alert-<%= typeof error !== 'undefined' && error ? 'error' : 'info' %>">
        <i class="ri-information-line"></i> <%= msg %>
      </div>
      <% } %>

      <form action="/login" method="POST" class="auth-form">
        <div class="form-group">
          <label for="email"><i class="ri-mail-line"></i> Email Address</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email">
        </div>
        <div class="form-group">
          <label for="password"><i class="ri-lock-line"></i> Password</label>
          <div class="password-wrap">
            <input type="password" id="password" name="password" placeholder="Enter your password" required>
            <button type="button" class="toggle-pwd" onclick="togglePwd()"><i class="ri-eye-line" id="eyeIcon"></i></button>
          </div>
        </div>
        <button type="submit" class="btn-auth-submit">Login <i class="ri-arrow-right-line"></i></button>
      </form>

      <div class="auth-divider"><span>Or try demo accounts</span></div>
      <div class="demo-accounts">
        <button onclick="fillLogin('user@foodora.com','user123')" class="demo-btn">👤 Customer Demo</button>
        <button onclick="fillLogin('admin@foodora.com','admin123')" class="demo-btn">🛡️ Admin Demo</button>
      </div>

      <p class="auth-switch">Don't have an account? <a href="/register">Sign up free →</a></p>
    </div>
  </div>
</div>

<script>
function togglePwd() {
  const p = document.getElementById('password');
  const i = document.getElementById('eyeIcon');
  p.type = p.type === 'password' ? 'text' : 'password';
  i.className = p.type === 'text' ? 'ri-eye-off-line' : 'ri-eye-line';
}
function fillLogin(email, pwd) {
  document.getElementById('email').value = email;
  document.getElementById('password').value = pwd;
}
</script>
